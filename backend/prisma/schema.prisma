// =====================================================================
// Sothos — Schema do banco de dados
// PostgreSQL 16 + Prisma
//
// Convenção adotada:
//   - Models em PascalCase (padrão do Prisma / código TypeScript)
//   - Tabelas e colunas em snake_case via @map / @@map
//     (mantém o banco igual ao dicionário de dados do documento)
//
// Valores monetários usam Decimal, NUNCA Float.
// Float causa erro de arredondamento em soma de dinheiro, e o valor
// monetário do RFM é justamente uma soma de dinheiro.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  //npm run start:devurl      = env("DATABASE_URL")
  // comentei pq nossa versão do prisma é a 6, já está na 7 e nela não tem esse comando url = env
  // se quiser mudar alguma coisa na tabela (schema.prisma) , é preciso descomenta-la 
}

// =====================================================================
// ENUMS
// =====================================================================

enum Plataforma {
  NUVEMSHOP
  CSV // importação manual de arquivo
  // Novas plataformas entram aqui sem mudar o resto do schema
}

enum StatusLoja {
  ATIVA
  DESCONECTADA
  ERRO
}

enum PapelUsuario {
  ADMIN
  OPERADOR
}

// Status canônico do pedido.
// Cada plataforma nomeia diferente; o conector traduz para cá.
// Só pedidos PAGO e ENVIADO/ENTREGUE entram no cálculo de RFM.
enum StatusPedido {
  PENDENTE
  PAGO
  ENVIADO
  ENTREGUE
  CANCELADO
  DEVOLVIDO
}

enum TipoSincronizacao {
  CARGA_INICIAL
  INCREMENTAL
  MANUAL
}

enum StatusSincronizacao {
  EM_ANDAMENTO
  CONCLUIDA
  FALHA
  PARCIAL
}

enum StatusExecucaoSegmentacao {
  EM_ANDAMENTO
  CONCLUIDA
  FALHA
}

enum TipoCampanha {
  EMAIL
  WHATSAPP
  POPUP
}

enum StatusCampanha {
  RASCUNHO
  AGENDADA
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA
}

enum StatusExecucaoIa {
  SUCESSO
  FALHA
}

// =====================================================================
// CONTA E USUÁRIOS
// A Conta é o "inquilino" (tenant). Todo dado do sistema pertence a uma
// Conta. É ela que garante que um lojista não veja os dados de outro.
// =====================================================================

model Conta {
  id         String   @id @default(uuid())
  nome       String   @db.VarChar(120)
  ramo       String   @db.VarChar(80)
  ativa      Boolean  @default(true)
  criadoEm   DateTime @default(now()) @map("criado_em")
  alteradoEm DateTime @updatedAt @map("alterado_em")

  usuarios Usuario[]
  lojas    LojaConectada[]

  @@map("conta")
}

model Usuario {
  id        String       @id @default(uuid())
  contaId   String       @map("id_conta")
  nome      String       @db.VarChar(120)
  email     String       @unique @db.VarChar(180)
  senhaHash String       @map("senha_hash") @db.VarChar(255) // hash com argon2 ou bcrypt — NUNCA senha em texto
  papel     PapelUsuario @default(OPERADOR)
  ativo     Boolean      @default(true)
  ultimoLoginEm DateTime? @map("ultimo_login_em")
  criadoEm  DateTime     @default(now()) @map("criado_em")
  alteradoEm DateTime    @updatedAt @map("alterado_em")

  conta              Conta       @relation(fields: [contaId], references: [id], onDelete: Cascade)
  campanhasCriadas   Campanha[]  @relation("CampanhaCriadaPor")
  campanhasAprovadas Campanha[]  @relation("CampanhaAprovadaPor")
  tokensRecuperacao  TokenRecuperacaoSenha[]

  @@index([contaId])
  @@map("usuario")
}

model TokenRecuperacaoSenha {
  id        String    @id @default(uuid())
  usuarioId String    @map("id_usuario")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("token_recuperacao_senha")
}

// =====================================================================
// LOJA CONECTADA
// Substitui a entidade integracao_erp do documento original.
// Guarda o vínculo com a plataforma de e-commerce de origem.
// =====================================================================

model LojaConectada {
  id                    String     @id @default(uuid())
  contaId               String     @map("id_conta")
  plataforma            Plataforma
  idExterno             String?    @map("id_externo") @db.VarChar(80) // store_id na plataforma; nulo quando plataforma = CSV
  nome                  String     @db.VarChar(120)
  dominio               String?    @db.VarChar(180)
  moeda                 String     @default("BRL") @db.Char(3)
  fusoHorario           String     @default("America/Sao_Paulo") @map("fuso_horario") @db.VarChar(60)
  // Credenciais SEMPRE cifradas na aplicação antes de gravar.
  // Formato varia por plataforma, por isso Json.
  // Nunca serializar este campo em resposta de API.
  credenciais           Json?
  escopos               String[]
  status                StatusLoja @default(ATIVA)
  conectadaEm           DateTime   @default(now()) @map("conectada_em")
  ultimaSincronizacaoEm DateTime?  @map("ultima_sincronizacao_em")

  conta          Conta            @relation(fields: [contaId], references: [id], onDelete: Cascade)
  clientes       Cliente[]
  produtos       Produto[]
  pedidos        Pedido[]
  grupos         GrupoCliente[]
  execucoes      ExecucaoSegmentacao[]
  campanhas      Campanha[]
  sincronizacoes Sincronizacao[]

  // Impede a mesma loja ser conectada duas vezes na plataforma
  @@unique([plataforma, idExterno])
  @@index([contaId])
  @@map("loja_conectada")
}

model Sincronizacao {
  id                  String              @id @default(uuid())
  lojaId              String              @map("id_loja")
  tipo                TipoSincronizacao
  status              StatusSincronizacao @default(EM_ANDAMENTO)
  iniciadaEm          DateTime            @default(now()) @map("iniciada_em")
  finalizadaEm        DateTime?           @map("finalizada_em")
  clientesProcessados Int                 @default(0) @map("clientes_processados")
  produtosProcessados Int                 @default(0) @map("produtos_processados")
  pedidosProcessados  Int                 @default(0) @map("pedidos_processados")
  mensagemErro        String?             @map("mensagem_erro") @db.Text

  loja LojaConectada @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@index([lojaId, iniciadaEm])
  @@map("sincronizacao")
}

// =====================================================================
// DADOS CANÔNICOS
// Formato próprio da Sothos. O conector traduz o formato da plataforma
// para cá. Nenhum módulo de negócio conhece o formato de origem.
// =====================================================================

model Cliente {
  id             String    @id @default(uuid())
  lojaId         String?    @map("id_loja")
  idExterno      String?   @map("id_externo") @db.VarChar(80)
  nome           String    @db.VarChar(160)
  email          String   @db.VarChar(180)
  telefone       String   @db.VarChar(30)
  cpf            String?   @db.VarChar(30)
  cidade         String?   @db.VarChar(120)
  estado         String?   @db.Char(2)
  aceitaMarketing Boolean  @default(false) @map("aceita_marketing") // LGPD: base para envio de campanha
  criadoEmOrigem DateTime? @map("criado_em_origem")
  criadoEm       DateTime  @default(now()) @map("criado_em")
  alteradoEm     DateTime  @updatedAt @map("alterado_em")

  loja     LojaConectada?  @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  pedidos  Pedido[]
  analises AnaliseRfm[]
  grupos   ClienteGrupo[]
  campanhas CampanhaCliente[]

  // Chave de deduplicação: impede duplicar cliente a cada re-sincronização
  @@unique([lojaId, idExterno])
  @@index([lojaId, email])
  @@map("cliente")
}

// Agrupamento MANUAL criado pelo usuário.
// Não confundir com Segmento, que é gerado pelo K-Means.
model GrupoCliente {
  id         String   @id @default(uuid())
  lojaId     String   @map("id_loja")
  nome       String   @db.VarChar(120)
  descricao  String?  @db.VarChar(255)
  criadoEm   DateTime @default(now()) @map("criado_em")
  alteradoEm DateTime @updatedAt @map("alterado_em")

  loja     LojaConectada  @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  clientes ClienteGrupo[]

  @@unique([lojaId, nome])
  @@map("grupo_cliente")
}

model ClienteGrupo {
  clienteId String   @map("id_cliente")
  grupoId   String   @map("id_grupo")
  criadoEm  DateTime @default(now()) @map("criado_em")

  cliente Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  grupo   GrupoCliente @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@id([clienteId, grupoId])
  @@map("cliente_grupo")
}

model Produto {
  id             String   @id @default(uuid())
  lojaId         String   @map("id_loja")
  idExterno      String?  @map("id_externo") @db.VarChar(80)
  nome           String   @db.VarChar(200)
  sku            String?  @db.VarChar(80)
  categoria      String?  @db.VarChar(120)
  precoAtual     Decimal? @map("preco_atual") @db.Decimal(12, 2)
  ativo          Boolean  @default(true)
  criadoEmOrigem DateTime? @map("criado_em_origem")
  criadoEm       DateTime @default(now()) @map("criado_em")
  alteradoEm     DateTime @updatedAt @map("alterado_em")

  loja      LojaConectada     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  itens     ItemPedido[]
  campanhas CampanhaProduto[]

  @@unique([lojaId, idExterno])
  @@index([lojaId, sku])
  @@map("produto")
}

model Pedido {
  id             String       @id @default(uuid())
  lojaId         String       @map("id_loja")
  clienteId      String?      @map("id_cliente") // nulo permite pedido de visitante sem cadastro
  idExterno      String?      @map("id_externo") @db.VarChar(80)
  numero         String?      @db.VarChar(40)
  status         StatusPedido
  valorProdutos  Decimal      @map("valor_produtos") @db.Decimal(12, 2)
  valorFrete     Decimal      @default(0) @map("valor_frete") @db.Decimal(12, 2)
  valorDesconto  Decimal      @default(0) @map("valor_desconto") @db.Decimal(12, 2)
  valorTotal     Decimal      @map("valor_total") @db.Decimal(12, 2)
  moeda          String       @default("BRL") @db.Char(3)
  realizadoEm    DateTime     @map("realizado_em") // data do pedido na ORIGEM, não a data de importação
  criadoEm       DateTime     @default(now()) @map("criado_em")
  alteradoEm     DateTime     @updatedAt @map("alterado_em")

  loja    LojaConectada @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  cliente Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  itens   ItemPedido[]

  @@unique([lojaId, idExterno])
  // Índice desenhado para a consulta de RFM
  @@index([lojaId, clienteId, realizadoEm])
  @@index([lojaId, status, realizadoEm])
  @@map("pedido")
}

model ItemPedido {
  id            String  @id @default(uuid())
  pedidoId      String  @map("id_pedido")
  produtoId     String? @map("id_produto") // nulo se o produto foi excluído na origem
  nomeProduto   String  @map("nome_produto") @db.VarChar(200) // congelado no momento da venda
  sku           String? @db.VarChar(80)
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(12, 2) // congelado: mudar o preço no cadastro NÃO pode reescrever histórico
  valorTotal    Decimal @map("valor_total") @db.Decimal(12, 2)

  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([produtoId])
  @@map("item_pedido")
}

// =====================================================================
// SEGMENTAÇÃO (RFM + K-MEANS)
// Cada rodada gera uma ExecucaoSegmentacao com seus Segmentos e
// AnalisesRfm. Guardar por execução preserva o histórico e permite
// comparar segmentações de períodos diferentes.
// =====================================================================

model ExecucaoSegmentacao {
  id            String                    @id @default(uuid())
  lojaId        String                    @map("id_loja")
  status        StatusExecucaoSegmentacao @default(EM_ANDAMENTO)
  periodoInicio DateTime                  @map("periodo_inicio")
  periodoFim    DateTime                  @map("periodo_fim")
  dataReferencia DateTime                 @map("data_referencia") // data usada para calcular a Recência
  k             Int // número de clusters do K-Means
  parametros    Json? // escala dos scores, semente, iterações, etc.
  totalClientes Int?                      @map("total_clientes")
  iniciadaEm    DateTime                  @default(now()) @map("iniciada_em")
  finalizadaEm  DateTime?                 @map("finalizada_em")
  mensagemErro  String?                   @map("mensagem_erro") @db.Text

  loja      LojaConectada @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  segmentos Segmento[]
  analises  AnaliseRfm[]

  @@index([lojaId, iniciadaEm])
  @@map("execucao_segmentacao")
}

model Segmento {
  id          String  @id @default(uuid())
  execucaoId  String  @map("id_execucao")
  cluster     Int // índice do cluster retornado pelo K-Means
  nome        String  @db.VarChar(120) // ex.: "Campeões", "Em risco"
  descricao   String? @db.VarChar(500)
  tamanho     Int     @default(0) // quantidade de clientes no segmento
  centroide   Json? // coordenadas do centro do cluster
  recenciaMedia    Decimal? @map("recencia_media") @db.Decimal(10, 2)
  frequenciaMedia  Decimal? @map("frequencia_media") @db.Decimal(10, 2)
  valorMonetarioMedio Decimal? @map("valor_monetario_medio") @db.Decimal(12, 2)

  execucao  ExecucaoSegmentacao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  analises  AnaliseRfm[]
  campanhas Campanha[]

  @@unique([execucaoId, cluster])
  @@map("segmento")
}

model AnaliseRfm {
  id                 String   @id @default(uuid())
  execucaoId         String   @map("id_execucao")
  clienteId          String   @map("id_cliente")
  segmentoId         String?  @map("id_segmento")
  recenciaDias       Int      @map("recencia_dias")
  frequencia         Int
  valorMonetario     Decimal  @map("valor_monetario") @db.Decimal(12, 2)
  scoreR             Int      @map("score_r")
  scoreF             Int      @map("score_f")
  scoreM             Int      @map("score_m")
  ticketMedio        Decimal? @map("ticket_medio") @db.Decimal(12, 2)
  clv                Decimal? @db.Decimal(12, 2)
  probabilidadeChurn Decimal? @map("probabilidade_churn") @db.Decimal(5, 4) // 0.0000 a 1.0000
  calculadoEm        DateTime @default(now()) @map("calculado_em")

  execucao ExecucaoSegmentacao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  cliente  Cliente             @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  segmento Segmento?           @relation(fields: [segmentoId], references: [id], onDelete: SetNull)

  // Um cliente aparece uma única vez por execução
  @@unique([execucaoId, clienteId])
  @@index([segmentoId])
  @@index([clienteId])
  @@map("analise_rfm")
}

// =====================================================================
// CAMPANHAS
// =====================================================================

model Campanha {
  id           String         @id @default(uuid())
  lojaId       String         @map("id_loja")
  segmentoId   String?        @map("id_segmento") // nulo enquanto RASCUNHO (RN006 validado na transição de status)
  criadoPorId  String?        @map("id_criado_por")
  aprovadoPorId String?       @map("id_aprovado_por")
  tipo         TipoCampanha
  status       StatusCampanha @default(RASCUNHO)
  titulo       String         @db.VarChar(160)
  assunto      String?        @db.VarChar(200) // usado em campanha de e-mail
  conteudo     String?        @db.Text
  agendadaPara DateTime?      @map("agendada_para")
  aprovadaEm   DateTime?      @map("aprovada_em") // revisão humana obrigatória antes do disparo
  enviadaEm    DateTime?      @map("enviada_em")
  criadoEm     DateTime       @default(now()) @map("criado_em")
  alteradoEm   DateTime       @updatedAt @map("alterado_em")

  loja        LojaConectada     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  segmento    Segmento?         @relation(fields: [segmentoId], references: [id], onDelete: SetNull)
  criadoPor   Usuario?          @relation("CampanhaCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  aprovadoPor Usuario?          @relation("CampanhaAprovadaPor", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  clientes    CampanhaCliente[]
  produtos    CampanhaProduto[]
  execucoesIa ExecucaoIa[]

  @@index([lojaId, status])
  @@map("campanha")
}

model CampanhaCliente {
  campanhaId String   @map("id_campanha")
  clienteId  String   @map("id_cliente")
  criadoEm   DateTime @default(now()) @map("criado_em")

  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@id([campanhaId, clienteId])
  @@map("campanha_cliente")
}

model CampanhaProduto {
  campanhaId String   @map("id_campanha")
  produtoId  String   @map("id_produto")
  criadoEm   DateTime @default(now()) @map("criado_em")

  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  produto  Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([campanhaId, produtoId])
  @@map("campanha_produto")
}

// =====================================================================
// AUDITORIA DAS CHAMADAS DE IA
// =====================================================================

model ExecucaoIa {
  id           String           @id @default(uuid())
  campanhaId   String?          @map("id_campanha")
  provedor     String           @db.VarChar(60) // definir quando a equipe escolher
  modeloIa     String           @map("modelo_ia") @db.VarChar(80)
  prompt       String           @db.Text
  resposta     String?          @db.Text
  status       StatusExecucaoIa
  tokensEntrada Int?            @map("tokens_entrada")
  tokensSaida  Int?             @map("tokens_saida")
  duracaoMs    Int?             @map("duracao_ms")
  mensagemErro String?          @map("mensagem_erro") @db.Text
  criadoEm     DateTime         @default(now()) @map("criado_em")

  campanha Campanha? @relation(fields: [campanhaId], references: [id], onDelete: SetNull)

  @@index([campanhaId])
  @@map("execucao_ia")
}
